    "claim_attribution_recovery": {
      "claim_count": 11,
      "decisions": [
        {
          "claim_text": "过渡期生活救助和冬春救助属于政府灾害救助制度，巨灾保险赔付属于保险理赔，三者依据、办理主体和程序不同。",
          "deterministic_error": null,
          "id": 1,
          "reason": "原文分别提到冬春救助是制度性安排、巨灾保险按合同理赔，以及过渡期生活救助的资金下达，但未直接概括三者依据、办理主体和程序不同。",
          "reference_error": null,
          "status": "unsupported",
          "table_header": ""
        },
        {
          "claim_text": "1. 是否一回事：不是。",
          "deterministic_error": null,
          "id": 2,
          "reason": "原文未直接表述三者不是一回事。",
          "reference_error": null,
          "status": "unsupported",
          "table_header": ""
        },
        {
          "claim_text": "过渡期生活救助资金由财政部会同应急管理部按相关政策规定下达，应急管理部指导人员核定、资金发放等工作[资料3]；冬春救助是受灾群众安全温暖过冬的制度性安排，由应急管理部会同财政部印发工作通知并组织申报[资料1]；巨灾保险赔付则由承保机构按保险合同查勘定损、公示后支付理赔款[资料2]。",
          "deterministic_error": null,
          "id": 3,
          "reason": "该句混合三项制度，其中冬春救助由应急管理部会同财政部印发工作通知并组织申报、巨灾保险查勘定损公示后支付理赔款有原文支持，但过渡期生活救助资金由财政部会同应急管理部下达及应急管理部指导人员核定、资金发放等内容不在所给资料3原段中，整句不能全部支持。",
          "reference_error": null,
          "status": "unsupported",
          "table_header": ""
        },
        {
          "claim_text": "2. 过渡期生活救助依据：依据《国家自然灾害救助应急预案》办理。",
          "deterministic_error": null,
          "id": 4,
          "reason": "资料3原段未出现《国家自然灾害救助应急预案》这一名称，无法直接支持该句。",
          "reference_error": null,
          "status": "unsupported",
          "table_header": ""
        },
        {
          "claim_text": "该预案规定，根据省级财政、应急管理部门的资金申请及需救助人员规模，财政部会同应急管理部按相关政策规定下达过渡期生活救助资金；应急管理部指导做好人员核定、资金发放等工作[资料3]。",
          "deterministic_error": null,
          "id": 5,
          "reason": "资料3原段有资金下达和人员核定、资金发放的表述，但未出现《国家自然灾害救助应急预案》名称，不能支持该句全部内容。",
          "reference_error": null,
          "status": "unsupported",
          "table_header": ""
        },
        {
          "claim_text": "该资料为2024年修订版，但当前是否仍现行有效尚未核实[资料3]。",
          "deterministic_error": null,
          "id": 6,
          "reason": "仅说明该资料版本及现行有效性尚未核实，属于检索或核实范围说明。",
          "reference_error": null,
          "status": "limitation",
          "table_header": ""
        },
        {
          "claim_text": "3. 冬春救助依据：依据应急管理部会同财政部印发的冬春救助工作通知办理，通过国家自然灾害救助资金管理系统申报审批，程序为“户报、村评、乡审、县定”[资料1]。",
          "deterministic_error": null,
          "id": 7,
          "reason": "资料1原段支持冬春救助工作通知、申报系统和“户报、村评、乡审、县定”程序，但未明确“应急管理部会同财政部印发”及“国家自然灾害救助资金管理系统”的完整表述，整句不能全部支持。",
          "reference_error": null,
          "status": "unsupported",
          "table_header": ""
        },
        {
          "claim_text": "4. 巨灾保险赔付依据：依据保险合同及地方公共巨灾保险实施方案办理。",
          "deterministic_error": null,
          "id": 8,
          "reason": "资料2、4涉及宁波巨灾保险方案和合同理赔，但未直接概括巨灾保险赔付依据为保险合同及地方公共巨灾保险实施方案。",
          "reference_error": null,
          "status": "unsupported",
          "table_header": ""
        },
        {
          "claim_text": "以宁波市为例，依据《宁波市公共巨灾保险工作实施方案（2024—2026年）》，受灾居民向村（社区）报损，由联络员登记汇总并向承保机构报案，承保机构查勘定损、公示后按合同支付理赔款[资料2][资料4]。",
          "deterministic_error": null,
          "id": 9,
          "reason": "资料2、4支持宁波报损、登记汇总、报案、查勘定损、公示及按合同支付理赔款，但未出现《宁波市公共巨灾保险工作实施方案（2024—2026年）》这一完整名称，整句不能全部支持。",
          "reference_error": null,
          "status": "unsupported",
          "table_header": ""
        },
        {
          "claim_text": "该方案自2024年4月30日起施行[资料4]。",
          "deterministic_error": null,
          "id": 10,
          "reason": "资料4原段明确该方案自2024年4月30日起施行。",
          "reference_error": null,
          "status": "supported",
          "table_header": ""
        },
        {
          "claim_text": "其他地区的具体依据，现有资料未覆盖。",
          "deterministic_error": null,
          "id": 11,
          "reason": "仅说明现有资料未覆盖其他地区具体依据，属于资料范围说明。",
          "reference_error": null,
          "status": "limitation",
          "table_header": ""
        }
