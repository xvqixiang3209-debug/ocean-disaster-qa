# Windows production server. Use 0.0.0.0 only when trusted LAN access is needed.
APP_HOST=127.0.0.1
APP_PORT=8766
APP_THREADS=8

# TianDiTu browser-side key. Apply at https://console.tianditu.gov.cn/ and fill it once.
TIANDITU_API_KEY=

TYPHOON_DB_TYPE=sqlite
TYPHOON_SQLITE_PATH=typhoon/data/typhoon_history.sqlite3
TYPHOON_RAG_SQLITE_PATH=typhoon/data/typhoon_rag.sqlite3
TYPHOON_STORM_SURGE_PATH=typhoon/data/typhoon_history.sqlite3
TYPHOON_CURRENT_FILE=typhoon/current/current_typhoon.json

TYPHOON_REPORT_MODE=llm
TYPHOON_REPORT_MODEL=deepseek-v4-flash
TYPHOON_LLM_TIMEOUT_SECONDS=20
TYPHOON_LLM_TEMPERATURE=0.2
TYPHOON_LLM_TOP_P=0.8
TYPHOON_ALLOW_REPORT_OVERRIDE=false
TYPHOON_EXPOSE_INTERNAL_PATHS=false

# RAG fallback web search and bounded article-body reading.
TYPHOON_WEB_SEARCH_ENABLED=true
TYPHOON_WEB_SEARCH_PROVIDER=auto
TYPHOON_WEB_SEARCH_TIMEOUT_SECONDS=8
TYPHOON_WEB_SEARCH_MAX_RESULTS=5
TYPHOON_WEB_READ_ENABLED=true
TYPHOON_WEB_READ_TIMEOUT_SECONDS=12
TYPHOON_WEB_READ_MAX_PAGES=3
TYPHOON_WEB_READ_MAX_CHARS=48000
TYPHOON_WEB_SUMMARY_TIMEOUT_SECONDS=40

# Fill this once on the target computer. Never distribute a real key in the ZIP.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
