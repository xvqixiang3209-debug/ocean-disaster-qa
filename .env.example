APP_HOST=127.0.0.1
APP_PORT=8767
TYPHOON_REPORT_MODE=template
TYPHOON_REPORT_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
TIANDITU_API_KEY=
ZJOCEAN_GRID_ID=
ZJOCEAN_GRID_CODE=
ZJOCEAN_GRID_SALT=
ZJOCEAN_WARNING_TOKEN=
# The workbench is local-only. Never put API secrets in browser code.
# Enabling a model does not authorize every document. Approve per-source external use in the UI.
MARINE_EXTERNAL_MODEL_ENABLED=false
# When true, generation failures are reported instead of silently returning excerpts.
MARINE_REQUIRE_MODEL_ANSWER=false
MARINE_QA_MODEL=deepseek-v4-flash
# When enabled, local and official-web evidence are combined per subquestion.
MARINE_WEB_ENABLED=false
TYPHOON_WEB_SEARCH_ENABLED=false
TYPHOON_WEB_READ_ENABLED=false
MARINE_FORECAST_WORKER=false
MARINE_WARNING_WORKER=false
MARINE_FACET_CONTRACT=true
MARINE_EVIDENCE_UNITS=true
MARINE_SCOPE_GATE=true
MARINE_CONNECTOR_V2=true
MARINE_TYPED_GROUNDING=on
MARINE_RELATION_GUARD=on
MARINE_LOCAL_OCR_ENABLED=true
MARINE_LOCAL_OCR_MAX_PAGES=30
MARINE_LOCAL_OCR_TIMEOUT=120
